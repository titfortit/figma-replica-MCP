{
  "name": "figma-replica",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "homepage": "https://titfortit.github.io/figma-replica-MCP",
  "scripts": {
    "dev": "vite",
    "dev:watch": "concurrently \"vite\" \"node watch-figma.js\"",
    "watch": "node watch-figma.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5173",
    "sync": "node sync-figma.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "stats": "node check-stats.js",
    "signups": "node check-signups.js",
    "view-signups": "node view-signups.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "firebase": "^12.6.0",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.554.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "figma-developer-mcp": "^0.6.4",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}
